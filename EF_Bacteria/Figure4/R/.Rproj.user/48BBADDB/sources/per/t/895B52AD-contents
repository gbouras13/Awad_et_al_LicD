library(ape)
library(phangorn)
library(ggtree)
library(tidyverse)

# load tree data and midpoint root 

tree <- read.tree("../Muhammed_mashtree/mashtree.dnd")            # load in the tree
tree$edge.length <- pmax(tree$edge.length, 0.0)  # set any negative branch lengths to zero
tree <- midpoint(tree)                           # midpoint-root the tree

tree$tip.label



# load meta data and remove references 
meta <- read.csv(file = "metadata.csv" )

ref_ids <- meta  %>% pull(id)


# change tree tipname 


# make tree 

p <- ggtree(tree) %<+% meta + 
  geom_tippoint(aes(color=Source), size =8) +
  geom_tiplab(align=TRUE, linetype='dashed', linesize=.05, offset=.001, colour= "black",size = 12) +
  scale_color_manual(values = c("gold","green", "pink"), name="Source") + 
  geom_treescale(x=0, y=15)+
  xlim(NA,0.043)+
  ylim(NA,16)

p





