library(ape)
library(phangorn)
library(ggtree)
library(tidyverse)

# load tree data and midpoint root 

tree <- read.tree("../Muhammed_mashtree/mashtree.dnd")            # load in the tree
tree$edge.length <- pmax(tree$edge.length, 0.0)  # set any negative branch lengths to zero
tree <- midpoint(tree)                           # midpoint-root the tree

tree$tip.label



# load meta data and remove references 
meta <- read.csv(file = "metadata.csv" )

ref_ids <- meta  %>% pull(id)


# change tree tipname 


# make tree 

p <- ggtree(tree) %<+% meta + 
  #geom_tippoint(aes(color=Source), size =8) +
  geom_tiplab(align=TRUE, linetype='dashed', linesize=.05, offset=.001, colour= "black",size = 12) +
  scale_color_manual(values = c("gold","green", "pink"), name="Source") + 
  geom_treescale(x=0, y=15)+
  xlim(NA,0.043)+
  ylim(NA,16)

p

### vre

heatmapData=meta%>% 
  dplyr::select(Source)
rownames(heatmapData) <- meta$id

heatmapData$Source <- gsub("Wastewater", "WW", heatmapData$Source)

heatmapData$label <- rownames(heatmapData)

tips <- p$data[p$data$isTip, c("label", "y")]


heatmapData$label <- rownames(heatmapData)  # if rownames are tip labels
text_df <- merge(tips, heatmapData[, c("label", "Source")], by = "label")

text_df$x <- max(p$data$x) + 0.03  # Adjust spacing as needed



# Add width/height for each tile (fixed)
tile_width <- 0.01
tile_height <- 0.9  # vertical spacing (adjust if your tree has different y scaling)

# Plot with tile + text
p2 <- p +
  geom_tile(data = text_df, aes(x = x, y = y, width = tile_width, height = tile_height), 
            fill = NA, color = "black", linewidth = 0.3) +
  geom_text(data = text_df, aes(x = x, y = y, label = Source), size = 10) +
  annotate("text", x = max(text_df$x), y = max(text_df$y) + 1, 
           label = "Source", angle = 90, size = 8, hjust = 0) +
  xlim(0, max(text_df$x) + 0.1)

p2






