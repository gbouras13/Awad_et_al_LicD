col1[4] <- "#000000"

heatmapData=meta%>% 
  dplyr::select(APTC.Efa10, APTC.Efa16, APTC.Efa20) 

rownames(heatmapData) <- meta$id

# Categorize the EOP values
eop_cat <- heatmapData %>%
  mutate(across(everything(), ~ case_when(
    . <= 0.001             ~ "<=0.001 (-)",
    . > 0.001 & . <= 0.1   ~ ">0.001,<=0.1 (+)",
    . > 0.1  & . <= 0.5    ~ ">0.01,<=0.5 (++)",
    . > 0.5                ~ ">0.5 (+++)"
  )))


# View result
print(eop_cat)


eop_cat$`APTC.Efa10` <- factor(eop_cat$`APTC.Efa10`,
                               levels = c("<=0.001 (-)", 
                                          ">0.001,<=0.1 (+)", 
                                          ">0.01,<=0.5 (++)",
                                          ">0.5 (+++)" ))

eop_cat$`APTC.Efa16` <- factor(eop_cat$`APTC.Efa16`,
                               levels = c("<=0.001 (-)", 
                                          ">0.001,<=0.1 (+)", 
                                          ">0.01,<=0.5 (++)",
                                          ">0.5 (+++)" ))

eop_cat$`APTC.Efa20` <- factor(eop_cat$`APTC.Efa20`,
                                   levels = c("<=0.001 (-)", 
                                              ">0.001,<=0.1 (+)", 
                                              ">0.01,<=0.5 (++)",
                                              ">0.5 (+++)" ))

colnames(eop_cat)[1] <- "APTC-Efa.10"
colnames(eop_cat)[2] <- "APTC-Efa.16"
colnames(eop_cat)[3] <- "APTC-Efa.20"

names(col1) <- levels(heatmapData$APTC.Efa10)

p8 <- gheatmap(p2,
               eop_cat, 
               offset = 0.036, 
               width = 1.2,
               colnames_position='top', 
               colnames_angle=45,
               colnames_offset_y = 0, 
               hjust=0, 
               font.size = 5,
               legend_title = "EOP")+
  scale_fill_manual(values=col1, 
                    name= "Phage Sensitivity (EOP)",
                    breaks = levels(eop_cat$`APTC-Efa.10`)) 

